# Copy to .env. docs/SETUP_ACCOUNTS.md explains where each value comes from.
# A platform whose keys are empty is marked "not run".

# ---- local infra (defaults match docker-compose.yml) ----
SERVER_PORT=4000
WEB_URL=http://localhost:5173
# Public HTTPS URL of the API server; only needed for Twilio's and Ably's moderation hooks (ngrok http 4000)
PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://mkt:mkt@localhost:5433/mkt
REDIS_URL=redis://localhost:6379
NATIVE_TOKEN_SECRET=change-me-to-a-long-random-string

# ---- optional: server-side translation for native and Rocket.Chat (deepl | google; empty = not run) ----
TRANSLATION_PROVIDER=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ---- vendors ----
# Sendbird
SENDBIRD_APP_ID=
SENDBIRD_API_TOKEN=
SENDBIRD_REGION=north-virginia-1
SENDBIRD_PLAN=free-trial

# Stream
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_REGION=us-east
STREAM_PLAN=build

# TalkJS
TALKJS_APP_ID=
TALKJS_SECRET_KEY=
TALKJS_REGION=eu
TALKJS_PLAN=test-mode

# CometChat
COMETCHAT_APP_ID=
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=
COMETCHAT_REST_API_KEY=
COMETCHAT_PLAN=build

# Twilio Conversations (classic) — not run yet
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_REGION=us1
TWILIO_PLAN=trial

# PubNub — not run yet
PUBNUB_PUBLISH_KEY=
PUBNUB_SUBSCRIBE_KEY=
PUBNUB_SECRET_KEY=
PUBNUB_REGION=us-east-1
PUBNUB_PLAN=free

# Ably — not run yet
ABLY_API_KEY=
ABLY_REGION=nearest-edge
ABLY_PLAN=free

# Rocket.Chat (self-hosted; docker compose --profile rocketchat)
ROCKETCHAT_URL=http://localhost:3000
ROCKETCHAT_ADMIN_USER=admin
ROCKETCHAT_ADMIN_PASSWORD=
ROCKETCHAT_CREATE_TOKENS_SECRET=
ROCKETCHAT_SKIP_WIZARD=1
ROCKETCHAT_PLAN=community-unregistered
ROCKETCHAT_AUTOTRANSLATE_ENABLED=
