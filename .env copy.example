# Copy to .env. Only keys that are present are used; a platform with missing keys is marked "not run".
# docs/SETUP_ACCOUNTS.md explains where each value comes from.

# ---- local infra (defaults match docker-compose.yml) ----
SERVER_PORT=4000
WEB_URL=http://localhost:5173
# Public HTTPS URL of the API server for vendor webhooks (ngrok http 4000 -> paste here)
PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://mkt:mkt@localhost:5433/mkt
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_URL=http://localhost:8025
NATIVE_TOKEN_SECRET=change-me-to-a-long-random-string

# ---- optional shared providers ----
# Web push through each platform's push integration is only configured when these are present.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
# Server-side translation for platforms without their own: deepl | google (leave empty = not run)
TRANSLATION_PROVIDER=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ---- vendors (filled in from docs/SETUP_ACCOUNTS.md) ----
# Sendbird — docs/SETUP_ACCOUNTS.md#sendbird-baseline
SENDBIRD_APP_ID=
SENDBIRD_API_TOKEN=
SENDBIRD_REGION=north-virginia-1
SENDBIRD_PLAN=free-trial

# Stream
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_REGION=us-east
STREAM_PLAN=build

# TalkJS
TALKJS_APP_ID=
TALKJS_SECRET_KEY=
TALKJS_REGION=eu
TALKJS_PLAN=test-mode

# CometChat
COMETCHAT_APP_ID=
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=
COMETCHAT_REST_API_KEY=
COMETCHAT_WEBHOOK_USER=
COMETCHAT_WEBHOOK_PASS=
COMETCHAT_FCM_PROVIDER_ID=
COMETCHAT_PLAN=build

# Twilio Conversations (classic)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SELLER_PHONE=
TWILIO_REGION=us1
TWILIO_PLAN=trial

# PubNub
PUBNUB_PUBLISH_KEY=
PUBNUB_SUBSCRIBE_KEY=
PUBNUB_SECRET_KEY=
PUBNUB_WEBHOOK_SECRET=
PUBNUB_REGION=us-east-1
PUBNUB_PLAN=free

# Ably
ABLY_API_KEY=
ABLY_REGION=nearest-edge
ABLY_PLAN=free

# Rocket.Chat (self-hosted; see docker-compose.yml profile "rocketchat")
ROCKETCHAT_URL=http://localhost:3000
ROCKETCHAT_ADMIN_USER=admin
ROCKETCHAT_ADMIN_PASSWORD=
ROCKETCHAT_CREATE_TOKENS_SECRET=
ROCKETCHAT_SKIP_WIZARD=0
ROCKETCHAT_PLAN=starter
